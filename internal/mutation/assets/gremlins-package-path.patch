+func (mu *Engine) pkgName(fileName, _ string) string {
+	directory := filepath.Dir(filepath.Join(mu.module.CallingDir, fileName))
+	if directory == "." {
+		return mu.module.Name
+	}
+
+	return mu.module.Name + "/" + filepath.ToSlash(directory)
