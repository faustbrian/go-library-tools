              },
              "scenario": {
                "const": "success,failure,denial"
              },
              "preconditions": {
                "const": "Operations: identity.reference.schema-generate, identity.user.create, identity.user.get; exact inputs: field_declarations, defaults, validation_rules, permissions, sensitivity; initial state: typed user, account, and session field declarations are versioned"
              },
              "stimulus": {
                "const": "Run identity.reference.schema-generate then identity.user.create then identity.user.get for success, failure, denial cases using field_declarations, defaults, validation_rules, permissions, sensitivity and capture every required artifact field"
              },
              "expected_outcome": {
                "const": "Invariant: generated schema matches declarations and runtime create and read preserve types, defaults, permissions, redaction, and migration version; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: field_count, schema_version, defaulted_field_count, redacted_field_count, schema_digest"
              },
              "actual_outcome": {
                "const": "Invariant: generated schema matches declarations and runtime create and read preserve types, defaults, permissions, redaction, and migration version; stable outcomes: success=pass/none, failure=failed/internal, denial=denied/forbidden; required artifact fields: field_count, schema_version, defaulted_field_count, redacted_field_count, schema_digest"
