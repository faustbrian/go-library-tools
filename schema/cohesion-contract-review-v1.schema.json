{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-contract-review-v1.schema.json",
  "title": "Cohesion Contract Review V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "goal_id", "contract", "review", "release", "created_at"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:contract-review:v1"},
    "goal_id": {"const": "golib-cohesion-v1"},
    "contract": {"$ref": "#/$defs/contract"},
    "review": {"$ref": "#/$defs/review"},
    "release": {"$ref": "#/$defs/release"},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "tag", "tag_object_sha", "peeled_commit", "bytes_sha256"],
      "properties": {
        "repository": {"const": "github.com/faustbrian/go-library-tools"},
        "path": {"const": "docs/ecosystem/goals/cohesion-v1.md"},
        "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "maxLength": 128},
        "tag_object_sha": {"$ref": "#/$defs/git_sha"},
        "peeled_commit": {"$ref": "#/$defs/git_sha"},
        "bytes_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_commit", "outcome", "findings"],
      "properties": {
        "reviewer_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "reviewed_commit": {"$ref": "#/$defs/git_sha"},
        "outcome": {"enum": ["accepted-no-findings", "rejected"]},
        "findings": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {"const": "accepted-no-findings"},
            "findings": {"maxItems": 0}
          }
        },
        {
          "properties": {
            "outcome": {"const": "rejected"},
            "findings": {"minItems": 1}
          }
        }
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_run_id", "workflow_outcome", "url"],
      "properties": {
        "workflow_run_id": {"type": "integer", "minimum": 1},
        "workflow_outcome": {"const": "success"},
        "url": {"type": "string", "pattern": "^https://github\\.com/faustbrian/go-library-tools/releases/tag/v", "maxLength": 4096}
      }
    },
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$", "maxLength": 128}
  }
}
