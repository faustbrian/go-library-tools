{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-delivery-evidence-v1.schema.json",
  "title": "Golib cohesion delivery evidence schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "entry_count", "entries"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:delivery-evidence:v1"},
    "schema_version": {"const": 1},
    "entry_count": {"type": "integer", "minimum": 0, "maximum": 4096, "description": "Must equal entries length."},
    "entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"},
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9./:_-]*[a-z0-9])?$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "A repository-relative regular-file path. The exact released safeRelativePath algorithm and the 4096-byte UTF-8 bound are mandatory semantic checks; this shape intentionally does not narrow its accepted character set."},
    "working_directory": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/path"}], "description": "A canonical repository-relative working directory; exact dot denotes the repository root, otherwise the released safeRelativePath algorithm is mandatory."},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "semver": {"type": "string", "maxLength": 128, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
    "tool_release": {"oneOf": [
      {"type": "string", "maxLength": 128, "pattern": "^v(?:[2-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
      {"type": "string", "maxLength": 128, "pattern": "^v1\\.(?:[6-9]|[1-9][0-9]+)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"},
      {"type": "string", "maxLength": 128, "pattern": "^v1\\.5\\.(?:[6-9]|[1-9][0-9]+)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"}
    ], "description": "Canonical v-prefixed SemVer strictly greater than v1.5.5."},
    "url": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifact_tracked": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "source_revision", "bytes_sha256"],
      "properties": {"kind": {"const": "tracked-file"}, "path": {"$ref": "#/$defs/path"}, "source_revision": {"$ref": "#/$defs/commit"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the tracked blob; this field is external to the hashed blob bytes."}}
    },
    "artifact_release": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository", "release", "asset", "url", "bytes_sha256"],
      "properties": {"kind": {"const": "release-asset"}, "repository": {"$ref": "#/$defs/identity"}, "release": {"type": "string", "minLength": 1, "maxLength": 128}, "asset": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/]+$"}, "url": {"$ref": "#/$defs/url"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the immutable release asset; this field is external to the hashed asset bytes."}}
    },
    "artifact": {"oneOf": [{"$ref": "#/$defs/artifact_tracked"}, {"$ref": "#/$defs/artifact_release"}]},
    "released_tool": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "repository", "release", "tag_object_sha", "peeled_commit", "goos", "goarch", "executable_asset", "executable_url", "platform_artifact_sha256", "checksums_asset", "checksums_url", "checksums_sha256", "release_manifest_asset", "release_manifest_url", "release_manifest_sha256"],
      "properties": {
        "kind": {"const": "release"}, "repository": {"const": "github.com/faustbrian/go-library-tools"}, "release": {"$ref": "#/$defs/tool_release"}, "tag_object_sha": {"$ref": "#/$defs/commit"}, "peeled_commit": {"$ref": "#/$defs/commit"}, "goos": {"$ref": "#/$defs/identity"}, "goarch": {"$ref": "#/$defs/identity"},
        "executable_asset": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/]+$"}, "executable_url": {"$ref": "#/$defs/url"}, "platform_artifact_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the released executable asset; this field is external to the hashed executable bytes."}, "checksums_asset": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/]+$"}, "checksums_url": {"$ref": "#/$defs/url"}, "checksums_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the immutable checksum-set asset; this field is external to the hashed checksum bytes."}, "release_manifest_asset": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^/]+$"}, "release_manifest_url": {"$ref": "#/$defs/url"}, "release_manifest_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the immutable release-manifest asset; this field is external to the hashed manifest bytes."}
      }
    },
    "go_toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "goos", "goarch", "distribution_sha256", "tree_sha256", "binary_sha256"],
      "properties": {"version": {"type": "string", "maxLength": 128, "pattern": "^go(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"}, "goos": {"const": "linux"}, "goarch": {"enum": ["amd64", "arm64"]}, "distribution_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the official Go distribution archive; this field is external to the hashed archive bytes."}, "tree_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the complete extracted toolchain tree; no digest field is present in its preimage."}, "binary_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the selected Go executable; this field is external to the hashed executable bytes."}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "policy_sha256"],
      "properties": {"rule_id": {"$ref": "#/$defs/identity"}, "policy_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the reconstructed effective policy with policy_sha256 omitted."}}
    },
    "environment_row": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z_][A-Z0-9_]*$"}, "value": {"type": "string", "maxLength": 1048576}}
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "source_revision", "working_directory", "environment", "module_proxy_sha256", "timeout_seconds"],
      "properties": {"repository": {"$ref": "#/$defs/identity"}, "source_revision": {"$ref": "#/$defs/commit"}, "working_directory": {"$ref": "#/$defs/working_directory"}, "environment": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"$ref": "#/$defs/environment_row"}}, "module_proxy_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the complete copied module-proxy tree; no digest field is present in the tree preimage."}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}
    },
    "reverse_consumer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "module", "source_revision", "consumed_module", "selected_version", "execution", "input_artifact_sha256", "result_artifact_sha256", "reason"],
      "properties": {"repository": {"$ref": "#/$defs/identity"}, "module": {"type": "string", "minLength": 1, "maxLength": 4096}, "source_revision": {"$ref": "#/$defs/commit"}, "consumed_module": {"type": "string", "minLength": 1, "maxLength": 4096}, "selected_version": {"type": "string", "minLength": 1, "maxLength": 128}, "execution": {"$ref": "#/$defs/execution"}, "input_artifact_sha256": {"$ref": "#/$defs/digest", "description": "Digest domain: semantic-object. The preimage is the exact reverse-consumer-input semantic object with input_artifact_sha256 omitted."}, "result_artifact_sha256": {"$ref": "#/$defs/digest", "description": "Digest domain: semantic-object. The preimage is the exact reverse-consumer-result semantic object with result_artifact_sha256 omitted."}, "reason": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "ordinary_input_row": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "path", "mode", "bytes_sha256", "reason"],
      "properties": {"category": {"enum": ["policy", "dependency", "test", "production", "toolchain", "build", "api", "specification", "documentation", "repository-other"]}, "path": {"$ref": "#/$defs/path"}, "mode": {"enum": ["100644", "100755", "120000"]}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the Git blob; this field is external to the hashed blob bytes."}, "reason": {"enum": ["policy:configured", "policy:coordination", "dependency:module", "dependency:vendor", "dependency:lock", "test:go", "test:data", "test:configured", "production:go", "production:embed", "toolchain:declaration", "build:workflow", "build:entrypoint", "build:configured", "api:configured", "specification:configured", "documentation:path", "documentation:extension", "repository-other:fallback"]}}
    },
    "normalized_manifest_row": {
      "type": "object", "additionalProperties": false,
      "required": ["category", "path", "mode", "normalized_sha256", "reason"],
      "properties": {"category": {"const": "policy"}, "path": {"$ref": "#/$defs/path"}, "mode": {"enum": ["100644", "100755"]}, "normalized_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the delivery-neutral manifest; this field is outside its own preimage."}, "reason": {"const": "delivery-neutral module manifest"}}
    },
    "input_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["rows", "reverse_consumers"],
      "properties": {"rows": {"type": "array", "maxItems": 4096, "items": {"oneOf": [{"$ref": "#/$defs/ordinary_input_row"}, {"$ref": "#/$defs/normalized_manifest_row"}]}}, "reverse_consumers": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/reverse_consumer"}}}
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["module_version", "tag", "tag_object_sha", "peeled_commit", "release_manifest_sha256", "checksums_sha256", "artifacts", "clean_consumer_execution", "clean_consumer_input_sha256", "clean_consumer_result_sha256"],
      "properties": {"module_version": {"$ref": "#/$defs/semver"}, "tag": {"type": "string", "minLength": 1, "maxLength": 128}, "tag_object_sha": {"$ref": "#/$defs/commit"}, "peeled_commit": {"$ref": "#/$defs/commit"}, "release_manifest_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the module release manifest; this field is external to the hashed manifest bytes."}, "checksums_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the module release checksum set; this field is external to the hashed checksum bytes."}, "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact_release"}}, "clean_consumer_execution": {"$ref": "#/$defs/execution"}, "clean_consumer_input_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the clean-consumer-input preimage; this field is omitted from its own preimage."}, "clean_consumer_result_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the clean-consumer-result preimage; this field is omitted from its own preimage."}}
    },
    "common_entry": {
      "type": "object",
      "required": ["entry_id", "goal_id", "requirements_sha256", "repository", "module", "dimension", "evidence_kind", "source_revision", "artifacts", "verifier", "go_toolchain", "policy", "reverse_consumers", "input_manifest", "input_manifest_sha256", "complete_input_fingerprint"],
      "properties": {
        "entry_id": {"$ref": "#/$defs/identity"}, "goal_id": {"const": "golib-cohesion-v1"}, "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."}, "repository": {"$ref": "#/$defs/identity"}, "module": {"type": "string", "minLength": 1, "maxLength": 4096}, "dimension": {"enum": ["implementation", "hardening", "release"]}, "evidence_kind": {"enum": ["source-acceptance", "gate-attestation", "release-attestation", "blocked-decision", "not-applicable-decision"]}, "source_revision": {"$ref": "#/$defs/commit"}, "artifacts": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact"}}, "verifier": {"$ref": "#/$defs/released_tool"}, "go_toolchain": {"$ref": "#/$defs/go_toolchain"}, "policy": {"$ref": "#/$defs/policy"}, "reverse_consumers": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/reverse_consumer"}}, "input_manifest": {"$ref": "#/$defs/input_manifest"}, "input_manifest_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of input_manifest; this field is not in its preimage."}, "complete_input_fingerprint": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the closed complete-input-fingerprint preimage; this field is not in its preimage."}, "authorization_id": {"$ref": "#/$defs/authorization_id"}, "release": {"$ref": "#/$defs/release"}
      }
    },
    "gate_entry": {"allOf": [{"$ref": "#/$defs/common_entry"}, {"type": "object", "required": ["dimension", "evidence_kind"], "not": {"anyOf": [{"required": ["authorization_id"]}, {"required": ["release"]}]}, "properties": {"dimension": {"const": "hardening"}, "evidence_kind": {"const": "gate-attestation"}}}], "unevaluatedProperties": false},
    "source_entry": {"allOf": [{"$ref": "#/$defs/common_entry"}, {"type": "object", "required": ["dimension", "evidence_kind", "authorization_id"], "not": {"required": ["release"]}, "properties": {"dimension": {"const": "implementation"}, "evidence_kind": {"const": "source-acceptance"}, "authorization_id": {"$ref": "#/$defs/authorization_id"}}}], "unevaluatedProperties": false},
    "blocked_entry": {"allOf": [{"$ref": "#/$defs/common_entry"}, {"type": "object", "required": ["evidence_kind", "authorization_id"], "not": {"required": ["release"]}, "properties": {"evidence_kind": {"const": "blocked-decision"}, "authorization_id": {"$ref": "#/$defs/authorization_id"}}}], "unevaluatedProperties": false},
    "not_applicable_entry": {"allOf": [{"$ref": "#/$defs/common_entry"}, {"type": "object", "required": ["evidence_kind", "authorization_id"], "not": {"required": ["release"]}, "properties": {"evidence_kind": {"const": "not-applicable-decision"}, "authorization_id": {"$ref": "#/$defs/authorization_id"}}}], "unevaluatedProperties": false},
    "release_entry": {"allOf": [{"$ref": "#/$defs/common_entry"}, {"type": "object", "required": ["dimension", "evidence_kind", "authorization_id", "release"], "properties": {"dimension": {"const": "release"}, "evidence_kind": {"const": "release-attestation"}, "authorization_id": {"$ref": "#/$defs/authorization_id"}, "release": {"$ref": "#/$defs/release"}}}], "unevaluatedProperties": false},
    "entry": {"oneOf": [{"$ref": "#/$defs/gate_entry"}, {"$ref": "#/$defs/source_entry"}, {"$ref": "#/$defs/blocked_entry"}, {"$ref": "#/$defs/not_applicable_entry"}, {"$ref": "#/$defs/release_entry"}]}
  }
}
