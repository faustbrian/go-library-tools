{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-diagnostic-v1.schema.json",
  "title": "Golib cohesion machine diagnostic schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "status", "diagnostics"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:diagnostic:v1"},
    "schema_version": {"const": 1},
    "status": {"const": "failed"},
    "diagnostics": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/diagnostic"}}
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "path": {"description": "An RFC 6901 JSON Pointer locating the diagnostic, or the empty string for the whole document.", "type": "string", "maxLength": 4096, "pattern": "^(?:/(?:[^~/]|~[01])*)*$"},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "causes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/diagnostic"}}
      }
    }
  }
}
