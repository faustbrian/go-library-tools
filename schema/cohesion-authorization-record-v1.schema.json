{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-authorization-record-v1.schema.json",
  "title": "Golib cohesion authorization record schema v1",
  "type": "object",
  "oneOf": [
    {"$ref": "#/$defs/decision_review_record"},
    {"$ref": "#/$defs/release_authority_record"},
    {"$ref": "#/$defs/integration_role_record"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9./:_-]*[a-z0-9])?$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "A repository-relative regular-file path. The exact released safeRelativePath algorithm and the 4096-byte UTF-8 bound are mandatory semantic checks; this shape intentionally does not narrow its accepted character set."},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "delivery_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "goal_id", "requirements_sha256", "repository", "module", "dimension", "evidence_kind", "receipt_path", "receipt_sha256", "receipt_entry_id", "source_revision", "applicable_input_manifest_sha256", "outcome"],
      "properties": {"kind": {"const": "delivery"}, "goal_id": {"const": "golib-cohesion-v1"}, "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."}, "repository": {"$ref": "#/$defs/identity"}, "module": {"type": "string", "minLength": 1, "maxLength": 4096}, "dimension": {"enum": ["implementation", "hardening", "release"]}, "evidence_kind": {"enum": ["source-acceptance", "blocked-decision", "not-applicable-decision", "release-attestation"]}, "receipt_path": {"$ref": "#/$defs/path"}, "receipt_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the tracked receipt file; this field is external to the hashed receipt bytes."}, "receipt_entry_id": {"$ref": "#/$defs/identity"}, "source_revision": {"$ref": "#/$defs/commit"}, "applicable_input_manifest_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest of the receipt input manifest; the digest field is absent from its own preimage."}, "outcome": {"const": "accepted"}}
    },
    "integration_role_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "goal_id", "requirements_sha256", "repository", "module", "target", "selected_role", "outcome"],
      "properties": {"kind": {"const": "integration-role"}, "goal_id": {"const": "golib-cohesion-v1"}, "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."}, "repository": {"$ref": "#/$defs/identity"}, "module": {"type": "string", "minLength": 1, "maxLength": 4096}, "target": {"$ref": "#/$defs/identity"}, "selected_role": {"enum": ["adapter", "companion", "domain-owned"]}, "outcome": {"const": "accepted"}}
    },
    "record_common": {
      "type": "object",
      "required": ["schema_id", "schema_version", "authorization_id", "authorization_kind", "subject", "issuer_id", "created_at"],
      "properties": {"schema_id": {"const": "urn:golib:cohesion:authorization-record:v1"}, "schema_version": {"const": 1}, "authorization_id": {"$ref": "#/$defs/authorization_id"}, "authorization_kind": {"enum": ["decision-review", "release-authority", "integration-role-decision"]}, "subject": {"oneOf": [{"$ref": "#/$defs/delivery_subject"}, {"$ref": "#/$defs/integration_role_subject"}]}, "issuer_id": {"$ref": "#/$defs/authorization_id"}, "reviewer_id": {"$ref": "#/$defs/authorization_id"}, "release_verifier_id": {"$ref": "#/$defs/authorization_id"}, "created_at": {"$ref": "#/$defs/created_at"}}
    },
    "decision_review_record": {
      "allOf": [
        {"$ref": "#/$defs/record_common"},
        {
          "type": "object",
          "required": ["authorization_kind", "reviewer_id", "subject"],
          "not": {"required": ["release_verifier_id"]},
          "properties": {
            "authorization_kind": {"const": "decision-review"},
            "reviewer_id": {"$ref": "#/$defs/authorization_id"},
            "subject": {
              "allOf": [
                {"$ref": "#/$defs/delivery_subject"},
                {"oneOf": [
                  {"properties": {"dimension": {"const": "implementation"}, "evidence_kind": {"const": "source-acceptance"}}},
                  {"properties": {"evidence_kind": {"const": "blocked-decision"}}},
                  {"properties": {"evidence_kind": {"const": "not-applicable-decision"}}}
                ]}
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "release_authority_record": {"allOf": [{"$ref": "#/$defs/record_common"}, {"type": "object", "required": ["authorization_kind", "release_verifier_id", "subject"], "not": {"required": ["reviewer_id"]}, "properties": {"authorization_kind": {"const": "release-authority"}, "release_verifier_id": {"$ref": "#/$defs/authorization_id"}, "subject": {"allOf": [{"$ref": "#/$defs/delivery_subject"}, {"properties": {"dimension": {"const": "release"}, "evidence_kind": {"const": "release-attestation"}}}]}}}], "unevaluatedProperties": false},
    "integration_role_record": {"allOf": [{"$ref": "#/$defs/record_common"}, {"type": "object", "required": ["authorization_kind", "reviewer_id", "subject"], "not": {"required": ["release_verifier_id"]}, "properties": {"authorization_kind": {"const": "integration-role-decision"}, "reviewer_id": {"$ref": "#/$defs/authorization_id"}, "subject": {"$ref": "#/$defs/integration_role_subject"}}}], "unevaluatedProperties": false}
  }
}
