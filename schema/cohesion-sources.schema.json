{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-sources.schema.json",
  "title": "Golib cohesion catalog source lock schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_count", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "repository_count": {"type": "integer", "minimum": 1, "maximum": 256},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/consumer"},
          {"$ref": "#/$defs/release_source"}
        ]
      }
    }
  },
  "$defs": {
    "repository": {
      "type": "string",
      "pattern": "^github\\.com/faustbrian/go-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "commit_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "commit"],
      "properties": {
        "kind": {"const": "commit"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "tooling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "checksums_sha256"],
      "properties": {
        "version": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
        "checksums_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source", "tooling"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "source": {"$ref": "#/$defs/commit_source"},
        "tooling": {"$ref": "#/$defs/tooling"}
      }
    },
    "release_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source"],
      "properties": {
        "repository": {"const": "github.com/faustbrian/go-library-tools"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "release-source"}}
        }
      }
    }
  }
}
