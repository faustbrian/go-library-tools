{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-catalog-v2.schema.json",
  "title": "Golib cohesion catalog schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "manifest_schema_version",
    "view",
    "scope",
    "repository",
    "source_revision",
    "design_language",
    "tooling",
    "publication_status",
    "policies",
    "input_manifest_sha256",
    "source_lock",
    "planned_identities",
    "modules"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:golib:cohesion:catalog:v2"
    },
    "schema_version": {
      "const": 2
    },
    "manifest_schema_version": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        1,
        2,
        3,
        null
      ]
    },
    "view": {
      "enum": [
        "consumer",
        "engineering"
      ]
    },
    "scope": {
      "enum": [
        "repository",
        "ecosystem"
      ]
    },
    "repository": {
      "oneOf": [
        {
          "$ref": "#/$defs/repository"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_revision": {
      "oneOf": [
        {
          "$ref": "#/$defs/commit"
        },
        {
          "type": "null"
        }
      ]
    },
    "design_language": {
      "$ref": "#/$defs/design_language"
    },
    "tooling": {
      "oneOf": [
        {
          "$ref": "#/$defs/released_tool"
        },
        {
          "$ref": "#/$defs/source_build"
        }
      ]
    },
    "publication_status": {
      "enum": [
        "preview",
        "final-input",
        "final"
      ]
    },
    "policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 92,
      "items": {
        "oneOf": [
          {
            "$ref": "cohesion-gate-policy-v1.schema.json"
          },
          {
            "$ref": "#/$defs/ecosystem_policy"
          }
        ]
      }
    },
    "input_manifest_sha256": {
      "$ref": "#/$defs/digest",
      "description": "Semantic-object SHA-256 of the scope-tagged repository or ecosystem input-manifest preimage; this field is omitted from its own preimage."
    },
    "source_lock": {
      "oneOf": [
        {
          "$ref": "#/$defs/source_lock"
        },
        {
          "type": "null"
        }
      ]
    },
    "planned_identities": {
      "$ref": "cohesion-engineering-identities-v1.schema.json#/properties/identities"
    },
    "modules": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/consumer_v1"
          },
          {
            "$ref": "#/$defs/consumer_v2"
          },
          {
            "$ref": "#/$defs/consumer_v3"
          },
          {
            "$ref": "#/$defs/engineering_v1"
          },
          {
            "$ref": "#/$defs/engineering_v2"
          },
          {
            "$ref": "#/$defs/engineering_v3"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "repository"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "repository": {
            "$ref": "#/$defs/repository"
          },
          "source_revision": {
            "$ref": "#/$defs/commit"
          },
          "manifest_schema_version": {
            "enum": [
              1,
              2,
              3
            ]
          },
          "source_lock": {
            "type": "null"
          },
          "publication_status": {
            "enum": [
              "preview",
              "final-input"
            ]
          },
          "policies": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "cohesion-gate-policy-v1.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "ecosystem"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "repository": {
            "type": "null"
          },
          "source_revision": {
            "type": "null"
          },
          "manifest_schema_version": {
            "type": "null"
          },
          "source_lock": {
            "$ref": "#/$defs/source_lock"
          },
          "publication_status": {
            "enum": [
              "preview",
              "final"
            ]
          },
          "policies": {
            "minItems": 92,
            "maxItems": 92,
            "items": {
              "$ref": "#/$defs/ecosystem_policy"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "view": {
            "const": "consumer"
          }
        },
        "required": [
          "view"
        ]
      },
      "then": {
        "properties": {
          "planned_identities": {
            "maxItems": 0
          },
          "modules": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/consumer_v1"
                },
                {
                  "$ref": "#/$defs/consumer_v2"
                },
                {
                  "$ref": "#/$defs/consumer_v3"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "view": {
            "const": "engineering"
          }
        },
        "required": [
          "view"
        ]
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/engineering_v1"
                },
                {
                  "$ref": "#/$defs/engineering_v2"
                },
                {
                  "$ref": "#/$defs/engineering_v3"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "repository"
          },
          "manifest_schema_version": {
            "const": 1
          }
        },
        "required": [
          "scope",
          "manifest_schema_version"
        ]
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/consumer_v1"
                },
                {
                  "$ref": "#/$defs/engineering_v1"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "repository"
          },
          "manifest_schema_version": {
            "const": 2
          }
        },
        "required": [
          "scope",
          "manifest_schema_version"
        ]
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/consumer_v2"
                },
                {
                  "$ref": "#/$defs/engineering_v2"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "const": "repository"
          },
          "manifest_schema_version": {
            "const": 3
          }
        },
        "required": [
          "scope",
          "manifest_schema_version"
        ]
      },
      "then": {
        "properties": {
          "modules": {
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/consumer_v3"
                },
                {
                  "$ref": "#/$defs/engineering_v3"
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {"const": "repository"},
          "manifest_schema_version": {"const": 1},
          "view": {"const": "consumer"}
        },
        "required": ["scope", "manifest_schema_version", "view"]
      },
      "then": {
        "properties": {
          "modules": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "publication_status": {
            "enum": [
              "final-input",
              "final"
            ]
          }
        },
        "required": [
          "publication_status"
        ]
      },
      "then": {
        "properties": {
          "tooling": {
            "$ref": "#/$defs/released_tool"
          },
          "planned_identities": {
            "maxItems": 0
          },
          "modules": {
            "items": {
              "oneOf": [
                {
                  "$ref": "#/$defs/consumer_v3"
                },
                {
                  "$ref": "#/$defs/engineering_v3"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "description": "A lowercase SHA-256 digest; each containing field description fixes the exact-byte or semantic-object domain and omission rule.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bare_digest": {
      "description": "A legacy bare lowercase SHA-256 digest retained only at a frozen compatibility boundary; no containing field is omitted from that legacy digest domain unless its description says so.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^github\\.com/faustbrian/go-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "description": "A repository-relative regular-file path; the schema rejects absolute paths, backslashes, empty and dot segments, while the released safe-path algorithm and UTF-8 byte bound remain mandatory semantic checks without narrowing Unicode names.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "not": {"anyOf": [{"pattern": "^/"}, {"pattern": "\\\\"}, {"pattern": "//"}, {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}]}
    },
    "module_directory": {
      "oneOf": [
        {
          "const": "."
        },
        {
          "$ref": "#/$defs/path"
        }
      ]
    },
    "canonical_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9./:_-]*[a-z0-9])?$"
    },
    "semver_tag": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "string": {
      "type": "string",
      "maxLength": 1048576
    },
    "string_set": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/string"
      }
    },
    "nullable_string_set": {
      "oneOf": [
        {
          "$ref": "#/$defs/string_set"
        },
        {
          "type": "null"
        }
      ]
    },
    "legacy_v1_string_array_output": {
      "type": ["array", "null"],
      "items": {"type": "string", "maxLength": 1048576}
    },
    "legacy_v1_gates_output": {
      "type": ["object", "null"],
      "additionalProperties": {"type": "boolean"}
    },
    "legacy_v1_package_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_directory", "directory", "name", "import_path", "kind", "production", "executable", "coverage_required", "build_required", "build_tags"],
      "properties": {
        "module_directory": {"$ref": "#/$defs/string"},
        "directory": {"$ref": "#/$defs/string"},
        "name": {"$ref": "#/$defs/string"},
        "import_path": {"$ref": "#/$defs/string"},
        "kind": {"$ref": "#/$defs/string"},
        "production": {"type": "boolean"},
        "executable": {"type": "boolean"},
        "coverage_required": {"type": "boolean"},
        "build_required": {"type": "boolean"},
        "build_tags": {"$ref": "#/$defs/legacy_v1_string_array_output"}
      }
    },
    "legacy_v1_goal_evidence_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "requirements_sha256", "implementation_evidence", "verification_gates", "implementation_status"],
      "properties": {
        "file": {"$ref": "#/$defs/string"},
        "requirements_sha256": {"$ref": "#/$defs/string"},
        "implementation_evidence": {"$ref": "#/$defs/legacy_v1_string_array_output"},
        "verification_gates": {"$ref": "#/$defs/legacy_v1_string_array_output"},
        "implementation_status": {"$ref": "#/$defs/string"}
      }
    },
    "goal_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "requirements_sha256",
        "repository",
        "path",
        "release",
        "tag_object_sha",
        "peeled_commit"
      ],
      "properties": {
        "goal_id": {
          "const": "golib-cohesion-v1"
        },
        "requirements_sha256": {
          "const": "sha256:6e5ac948c2cf1ec439fdf90c53c0648befb74a65c3eca2eb595737ee8211891c",
          "description": "Exact-byte SHA-256 of the frozen v1.5.5 goal contract; no field is omitted."
        },
        "repository": {
          "const": "github.com/faustbrian/go-library-tools"
        },
        "path": {
          "const": "docs/ecosystem/goals/cohesion-v1.md"
        },
        "release": {
          "const": "v1.5.5"
        },
        "tag_object_sha": {
          "const": "6e54f464376865a60c618cce8f07fe70bcfabed0"
        },
        "peeled_commit": {
          "const": "66d2874dc98afe43dd7dad379d6f5e7d1b613111"
        }
      }
    },
    "design_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "repository",
        "path",
        "bytes_sha256",
        "release",
        "tag_object_sha",
        "peeled_commit",
        "goal_contract"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "repository": {
          "const": "github.com/faustbrian/go-library-tools"
        },
        "path": {
          "const": "docs/ecosystem/design-language.md"
        },
        "bytes_sha256": {
          "const": "sha256:d767f6d4d5eb3ba73861d898255d42691fac49101ea55edb079af3b1969357c8",
          "description": "Exact-byte SHA-256 of the frozen design-language file; no field is omitted."
        },
        "release": {
          "const": "v1.5.3"
        },
        "tag_object_sha": {
          "const": "c116e5d313ce7acedcb5d459f7737a85ef3cd34e"
        },
        "peeled_commit": {
          "const": "b1f8313166388c69a5b646686d19617bf75b53ca"
        },
        "goal_contract": {
          "$ref": "#/$defs/goal_contract"
        }
      }
    },
    "released_tool": {
      "$ref": "cohesion-sources-v2.schema.json#/$defs/released_tool"
    },
    "source_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "version",
        "source_commit",
        "executable_sha256"
      ],
      "properties": {
        "kind": {
          "const": "source-build"
        },
        "version": {
          "const": "dev"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "executable_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 of the source-built executable; no field is omitted."
        }
      }
    },
    "source_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "source_revision",
        "schema_id",
        "bytes_sha256"
      ],
      "properties": {
        "repository": {
          "const": "github.com/faustbrian/go-library-tools"
        },
        "path": {
          "const": "release/cohesion-sources-v2.json"
        },
        "source_revision": {
          "$ref": "#/$defs/commit"
        },
        "schema_id": {
          "const": "urn:golib:cohesion:sources:v2"
        },
        "bytes_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 of the pinned v2 source-lock file; no field is omitted."
        }
      }
    },
    "ecosystem_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "policy"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "policy": {
          "$ref": "cohesion-gate-policy-v1.schema.json"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_path",
        "receipt_sha256",
        "entry_id"
      ],
      "properties": {
        "receipt_path": {
          "$ref": "#/$defs/path"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 of the tracked receipt file; no field is omitted."
        },
        "entry_id": {
          "$ref": "#/$defs/canonical_identity"
        }
      }
    },
    "selected_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "entry_sha256",
        "entry",
        "input_manifest_sha256",
        "input_manifest",
        "complete_input_fingerprint"
      ],
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "entry_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Semantic-object SHA-256 of the RFC 8785 canonical receipt entry with no field omitted."
        },
        "entry": {
          "$ref": "cohesion-delivery-evidence-v1.schema.json#/$defs/entry"
        },
        "input_manifest_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Semantic-object SHA-256 of input_manifest; the digest is outside that preimage."
        },
        "input_manifest": {
          "$ref": "cohesion-delivery-evidence-v1.schema.json#/$defs/input_manifest"
        },
        "complete_input_fingerprint": {
          "$ref": "#/$defs/digest",
          "description": "Semantic-object SHA-256 of the complete-input-fingerprint preimage; this field is omitted from its own preimage."
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirements_sha256",
        "status"
      ],
      "properties": {
        "id": {
          "const": "golib-cohesion-v1"
        },
        "requirements_sha256": {
          "const": "sha256:6e5ac948c2cf1ec439fdf90c53c0648befb74a65c3eca2eb595737ee8211891c",
          "description": "Exact-byte SHA-256 of the frozen v1.5.5 goal contract; no field is omitted."
        },
        "status": {
          "enum": [
            "not-started",
            "in-progress",
            "blocked",
            "complete",
            "not-applicable"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "hardening",
        "release"
      ],
      "properties": {
        "implementation": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/selected_evidence"
          }
        },
        "hardening": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/selected_evidence"
          }
        },
        "release": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/selected_evidence"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "implementation",
        "hardening",
        "release",
        "evidence"
      ],
      "properties": {
        "goal": {
          "$ref": "#/$defs/goal"
        },
        "implementation": {
          "enum": [
            "not-started",
            "in-progress",
            "blocked",
            "not-applicable",
            "verified"
          ]
        },
        "hardening": {
          "enum": [
            "not-started",
            "in-progress",
            "blocked",
            "not-applicable",
            "verified"
          ]
        },
        "release": {
          "enum": [
            "not-started",
            "in-progress",
            "blocked",
            "not-applicable",
            "verified"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "integration_role": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "role",
            "provenance",
            "rationale"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/canonical_identity"
            },
            "role": {
              "enum": [
                "adapter",
                "companion",
                "domain-owned"
              ]
            },
            "provenance": {
              "const": "legacy-derived"
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "role",
            "provenance",
            "rationale",
            "authorization_id"
          ],
          "properties": {
            "target": {
              "$ref": "#/$defs/canonical_identity"
            },
            "role": {
              "enum": [
                "adapter",
                "companion",
                "domain-owned"
              ]
            },
            "provenance": {
              "const": "authorized"
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "authorization_id": {
              "$ref": "#/$defs/canonical_identity"
            }
          }
        }
      ]
    },
    "cohesion_v3": {
      "$ref": "modules-v3.schema.json#/$defs/cohesion"
    },
    "consumer_common": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "directory",
        "module_path",
        "go_version",
        "kind",
        "releasable",
        "version",
        "specifications",
        "owned_dependencies",
        "cohesion",
        "manifest_schema_version"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "directory": {
          "$ref": "#/$defs/string"
        },
