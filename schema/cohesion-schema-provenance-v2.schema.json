{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-schema-provenance-v2.schema.json",
  "title": "Cohesion Schema Provenance V2",
  "description": "A compact provenance envelope. One multiplexed oracle and one aggregate review cover the complete schema set; v1 remains immutable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "oracle", "review", "entry_count", "entries"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:schema-provenance:v2"},
    "schema_version": {"const": 2},
    "oracle": {"$ref": "#/$defs/asset", "description": "The single multiplexed oracle. Cases are keyed by schema_path."},
    "review": {"$ref": "#/$defs/asset", "description": "The single aggregate review of the multiplexed oracle and all entries."},
    "entry_count": {"const": 25},
    "entries": {
      "type": "array", "minItems": 25, "maxItems": 25,
      "items": {"$ref": "#/$defs/entry"},
      "allOf": [{"uniqueItems": true}]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safe_path": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "source_revision", "bytes_sha256"],
      "properties": {
        "repository": {"const": "github.com/faustbrian/go-library-tools"},
        "path": {"$ref": "#/$defs/safe_path"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "bytes_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_path", "schema_bytes_sha256", "kind"],
      "properties": {
        "schema_path": {"type": "string", "pattern": "^schema/[A-Za-z0-9._-]+\\.schema\\.json$"},
        "schema_bytes_sha256": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["historical-snapshot", "behavioral-characterization", "new-contract"]}
      }
    }
  }
}
