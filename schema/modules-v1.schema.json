{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/modules-v1.schema.json",
  "title": "Golib module inventory schema v1 behavioral characterization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 1},
    "go_version": {"type": ["string", "null"]},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "string_array": {
      "type": ["array", "null"],
      "items": {"type": ["string", "null"]}
    },
    "gates": {
      "type": ["object", "null"],
      "additionalProperties": {"type": ["boolean", "null"]}
    },
    "package": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "module_directory": {"type": ["string", "null"]},
        "directory": {"type": ["string", "null"]},
        "name": {"type": ["string", "null"]},
        "import_path": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "production": {"type": ["boolean", "null"]},
        "executable": {"type": ["boolean", "null"]},
        "coverage_required": {"type": ["boolean", "null"]},
        "build_required": {"type": ["boolean", "null"]},
        "build_tags": {"$ref": "#/$defs/string_array"}
      }
    },
    "goal_evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": ["string", "null"]},
        "requirements_sha256": {"type": ["string", "null"]},
        "implementation_evidence": {"$ref": "#/$defs/string_array"},
        "verification_gates": {"$ref": "#/$defs/string_array"},
        "implementation_status": {"type": ["string", "null"]}
      }
    },
    "module": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "directory": {"type": ["string", "null"]},
        "module_path": {"type": ["string", "null"]},
        "go_version": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "purpose": {"type": ["string", "null"]},
        "lifecycle": {"type": ["string", "null"]},
        "releasable": {"type": ["boolean", "null"]},
        "version": {"type": ["string", "null"]},
        "tag_prefix": {"type": ["string", "null"]},
        "gates": {"$ref": "#/$defs/gates"},
        "test_tags": {"$ref": "#/$defs/string_array"},
        "build_tags": {"$ref": "#/$defs/string_array"},
        "required_services": {"$ref": "#/$defs/string_array"},
        "external_runtime_dependencies": {"$ref": "#/$defs/string_array"},
        "interoperability_tools": {"$ref": "#/$defs/string_array"},
        "conformance_corpora": {"$ref": "#/$defs/string_array"},
        "specifications": {"$ref": "#/$defs/string_array"},
        "owned_dependencies": {"$ref": "#/$defs/string_array"},
        "reverse_owned_dependencies": {"$ref": "#/$defs/string_array"},
        "packages": {"type": ["array", "null"], "items": {"$ref": "#/$defs/package"}},
        "family": {"type": ["string", "null"]},
        "family_label": {"type": ["string", "null"]},
        "family_description": {"type": ["string", "null"]},
        "family_order": {"type": ["integer", "null"]},
        "goal_status": {"type": ["string", "null"]},
        "goal_files": {"$ref": "#/$defs/string_array"},
        "goal_evidence": {"type": ["array", "null"], "items": {"$ref": "#/$defs/goal_evidence"}},
        "provenance": true
      }
    }
  }
}
