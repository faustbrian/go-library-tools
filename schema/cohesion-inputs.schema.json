{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-inputs.schema.json",
  "title": "Golib cohesion aggregation inputs schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_language", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "design_language": {"$ref": "#/$defs/design_language"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repository_input"}
    }
  },
  "$defs": {
    "design_language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"const": "1.0"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "projection", "sha256"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^github\\.com/faustbrian/go-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "projection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:\\.*[A-Za-z0-9_-][A-Za-z0-9._-]*/)*\\.*[A-Za-z0-9_-][A-Za-z0-9._-]*$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
