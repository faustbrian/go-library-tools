{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/modules.schema.json",
  "title": "Golib module inventory schema v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "go_version", "modules"],
  "properties": {
    "schema_version": {"const": 2},
    "repository": {"type": "string", "minLength": 1},
    "go_version": {"$ref": "#/$defs/go_version"},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "go_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "nonblank_string": {"type": "string", "pattern": "\\S"},
    "string_set": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonblank_string"}},
    "identifier_set": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
    "nullable_document": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_directory", "directory", "name", "import_path", "kind", "production", "executable", "coverage_required", "build_required", "build_tags"],
      "properties": {
        "module_directory": {"type": "string"},
        "directory": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "import_path": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "production": {"type": "boolean"},
        "executable": {"type": "boolean"},
        "coverage_required": {"type": "boolean"},
        "build_required": {"type": "boolean"},
        "build_tags": {"$ref": "#/$defs/string_set"}
      }
    },
    "goal_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "requirements_sha256", "implementation_evidence", "verification_gates", "implementation_status"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "requirements_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "implementation_evidence": {"$ref": "#/$defs/string_set"},
        "verification_gates": {"$ref": "#/$defs/string_set"},
        "implementation_status": {"type": "string", "minLength": 1}
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api_compatibility": {"type": "boolean"},
        "benchmarks": {"type": "boolean"},
        "conformance": {"type": "boolean"},
        "coverage": {"type": "boolean"},
        "documentation": {"type": "boolean"},
        "fuzz": {"type": "boolean"},
        "interoperability": {"type": "boolean"},
        "lint": {"type": "boolean"},
        "mutation": {"type": "boolean"},
        "race": {"type": "boolean"},
        "security": {"type": "boolean"},
        "tests": {"type": "boolean"}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "mutable_inputs", "runtime_resources", "background_work"],
      "properties": {
        "configuration": {"enum": ["caller", "none"]},
        "mutable_inputs": {
          "oneOf": [
            {"const": ["none"]},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["borrow", "copy", "transfer"]}}
          ]
        },
        "runtime_resources": {"enum": ["caller", "none", "package", "shared"]},
        "background_work": {"enum": ["caller", "none", "package", "shared"]}
      }
    },
    "supported_go": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "tested"],
      "properties": {
        "minimum": {"$ref": "#/$defs/go_version"},
        "tested": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/go_version"}}
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readme", "api", "adoption", "security", "compatibility", "performance", "examples", "faq", "changelog", "pkg_go_dev", "ecosystem_index"],
      "properties": {
        "readme": {"$ref": "#/$defs/nullable_document"},
        "api": {"$ref": "#/$defs/nullable_document"},
        "adoption": {"$ref": "#/$defs/nullable_document"},
        "security": {"$ref": "#/$defs/nullable_document"},
        "compatibility": {"$ref": "#/$defs/nullable_document"},
        "performance": {"$ref": "#/$defs/nullable_document"},
        "examples": {"$ref": "#/$defs/nullable_document"},
        "faq": {"$ref": "#/$defs/nullable_document"},
        "changelog": {"$ref": "#/$defs/nullable_document"},
        "pkg_go_dev": {"$ref": "#/$defs/nullable_document"},
        "ecosystem_index": {"$ref": "#/$defs/nullable_document"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "hardening", "release"],
      "properties": {
        "implementation": {"$ref": "#/$defs/delivery_status"},
        "hardening": {"$ref": "#/$defs/delivery_status"},
        "release": {"$ref": "#/$defs/delivery_status"}
      }
    },
    "delivery_status": {"enum": ["blocked", "in-progress", "not-applicable", "not-started", "verified"]},
    "cohesion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "secondary_capabilities", "responsibility", "non_goals", "public_package_identifier", "primary_entry_packages", "package_selection", "lifecycle_status", "maturity", "construction_styles", "lifecycle_styles", "ownership", "optional_owned_dependencies", "adapters", "companions", "supported_go", "supported_platforms", "supported_backends", "supported_protocols", "documentation", "known_good_compatibility_sets", "delivery"],
      "properties": {
        "family": {"enum": ["foundations", "service-edge", "protocols-and-descriptions", "persistence-and-durability", "resilience", "observability", "integration-and-data-movement", "domain-utilities", "tooling"]},
        "secondary_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["administration-and-control", "configuration", "cryptography-and-secrets", "data-encoding", "database-and-storage", "distributed-coordination", "eventing-and-messaging", "http-and-service-edge", "identity-and-access", "observability", "protocols-and-schemas", "resilience-and-admission", "scheduling-and-orchestration", "testing-and-conformance", "transport-and-networking"]}},
        "responsibility": {"$ref": "#/$defs/nonblank_string"},
        "non_goals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonblank_string"}},
        "public_package_identifier": {"type": "string", "pattern": "^(none|[A-Za-z_][A-Za-z0-9_]*)$"},
        "primary_entry_packages": {"$ref": "#/$defs/string_set"},
        "package_selection": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonblank_string"}},
        "lifecycle_status": {"enum": ["active", "deprecated", "planned", "retired"]},
        "maturity": {"enum": ["experimental", "preview", "stable"]},
        "construction_styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["builder-build", "builder-compile", "connect", "functional-options", "init", "load", "must-helper", "new-config", "new-options", "open", "plain-function", "validated-value"]}},
        "lifecycle_styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["close", "drain", "run", "shutdown", "start", "stateless", "wait"]}},
        "ownership": {"$ref": "#/$defs/ownership"},
        "optional_owned_dependencies": {"$ref": "#/$defs/string_set"},
        "adapters": {"$ref": "#/$defs/string_set"},
        "companions": {"$ref": "#/$defs/string_set"},
        "supported_go": {"$ref": "#/$defs/supported_go"},
        "supported_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"}},
        "supported_backends": {"$ref": "#/$defs/identifier_set"},
        "supported_protocols": {"$ref": "#/$defs/identifier_set"},
        "documentation": {"$ref": "#/$defs/documentation"},
        "known_good_compatibility_sets": {"$ref": "#/$defs/string_set"},
        "delivery": {"$ref": "#/$defs/delivery"}
      },
      "allOf": [
        {
          "if": {"properties": {"lifecycle_status": {"const": "planned"}}, "required": ["lifecycle_status"]},
          "then": {"properties": {
            "maturity": {"enum": ["experimental", "preview"]},
            "documentation": {"properties": {"readme": {"type": "string", "minLength": 1}}}
          }}
        },
        {
          "if": {"properties": {"lifecycle_status": {"enum": ["active", "deprecated"]}}, "required": ["lifecycle_status"]},
          "then": {"properties": {"documentation": {"properties": {
            "readme": {"type": "string", "minLength": 1},
            "api": {"type": "string", "minLength": 1},
            "changelog": {"type": "string", "minLength": 1},
            "pkg_go_dev": {"type": "string", "minLength": 1},
            "ecosystem_index": {"type": "string", "minLength": 1}
          }}}}
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "module_path", "go_version", "kind", "purpose", "lifecycle", "releasable", "version", "tag_prefix", "gates", "test_tags", "build_tags", "required_services", "external_runtime_dependencies", "interoperability_tools", "conformance_corpora", "specifications", "owned_dependencies", "reverse_owned_dependencies", "packages", "family", "family_label", "family_description", "family_order", "goal_status", "goal_files", "goal_evidence", "provenance"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "module_path": {"type": "string", "minLength": 1},
        "go_version": {"$ref": "#/$defs/go_version"},
        "kind": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "lifecycle": {"type": "string"},
        "releasable": {"type": "boolean"},
        "version": {"type": "string"},
        "tag_prefix": {"type": "string"},
        "gates": {"$ref": "#/$defs/gates"},
        "test_tags": {"$ref": "#/$defs/string_set"},
        "build_tags": {"$ref": "#/$defs/string_set"},
        "required_services": {"$ref": "#/$defs/string_set"},
        "external_runtime_dependencies": {"$ref": "#/$defs/string_set"},
        "interoperability_tools": {"$ref": "#/$defs/string_set"},
        "conformance_corpora": {"$ref": "#/$defs/string_set"},
        "specifications": {"$ref": "#/$defs/string_set"},
        "owned_dependencies": {"$ref": "#/$defs/string_set"},
        "reverse_owned_dependencies": {"$ref": "#/$defs/string_set"},
        "packages": {"type": "array", "items": {"$ref": "#/$defs/package"}},
        "family": {"type": "string"},
        "family_label": {"type": "string"},
        "family_description": {"type": "string"},
        "family_order": {"type": "integer", "minimum": 0},
        "goal_status": {"type": "string"},
        "goal_files": {"$ref": "#/$defs/string_set"},
        "goal_evidence": {"type": "array", "items": {"$ref": "#/$defs/goal_evidence"}},
        "provenance": {"type": "array"},
        "cohesion": {"$ref": "#/$defs/cohesion"}
      },
      "allOf": [
        {
          "if": {"properties": {"releasable": {"const": true}}, "required": ["releasable"]},
          "then": {"required": ["cohesion"]}
        }
      ]
    }
  }
}
