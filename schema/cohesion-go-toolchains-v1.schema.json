{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-go-toolchains-v1.schema.json",
  "title": "Golib cohesion Go toolchains schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "official_index",
    "entry_count",
    "entries"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:golib:cohesion:go-toolchains:v1"
    },
    "schema_version": {
      "const": 1
    },
    "official_index": {
      "$ref": "#/$defs/official_index"
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "digest": {
      "description": "A lowercase SHA-256 digest; each containing field description fixes the exact-byte or semantic-object domain and omission rule.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "go_version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^go(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "official_index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "retrieved_at",
        "asset",
        "bytes_sha256"
      ],
      "properties": {
        "source_url": {
          "const": "https://go.dev/dl/?mode=json&include=all"
        },
        "retrieved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "asset": {
          "const": "cohesion-go-official-downloads.json"
        },
        "bytes_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 of the frozen official-index snapshot; no field is omitted."
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "goos",
        "goarch",
        "official_filename",
        "distribution_url",
        "distribution_sha256",
        "distribution_size",
        "tree_sha256",
        "binary_sha256"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/go_version"
        },
        "goos": {
          "const": "linux"
        },
        "goarch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "official_filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "distribution_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^https://go\\.dev/dl/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "distribution_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 of the official Go distribution archive; no field is omitted."
        },
        "distribution_size": {
          "type": "integer",
          "minimum": 1
        },
        "tree_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Semantic-object SHA-256 of the canonical complete extracted-tree row array; the digest is outside that preimage."
        },
        "binary_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 of the extracted bin/go regular file; no field is omitted."
        }
      }
    }
  }
}
