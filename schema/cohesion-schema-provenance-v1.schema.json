{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-schema-provenance-v1.schema.json",
  "title": "Cohesion Schema Provenance V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "decision_freeze", "entry_count", "entries"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:schema-provenance:v1"}, "schema_version": {"const": 1},
    "decision_freeze": {"$ref": "#/$defs/decision_freeze_asset"},
    "entry_count": {"const": 25},
    "entries": {
      "type": "array", "minItems": 25, "maxItems": 25,
      "$comment": "Semantic validation requires schema_path byte ordering, exactly the frozen 25-path set, and equal generator release identity across every nested locator.",
      "items": {"oneOf": [{"$ref": "#/$defs/historical_snapshot"}, {"$ref": "#/$defs/behavioral_characterization"}, {"$ref": "#/$defs/new_contract"}]},
      "allOf": [
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/modules-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/modules-v2.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/modules-v3.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-catalog-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-catalog-v2.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-inputs-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-inputs-v2.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-sources-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-sources-v2.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-delivery-evidence-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-authorization-registry-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-authorization-record-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-residual-inventory-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-residual-register-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-gate-policy-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-go-toolchains-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-go-official-downloads-oracle-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-go-official-downloads-oracle-review-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-engineering-identities-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-schema-provenance-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-schema-v3-decision-review-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-schema-v3-decision-freeze-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-contract-freeze-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-contract-review-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "properties": {"schema_path": {"const": "schema/cohesion-diagnostic-v1.schema.json"}}, "required": ["schema_path"]}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "oracle_git_locator": {"type": "object", "additionalProperties": false, "required": ["repository", "path", "source_revision", "bytes_sha256"], "properties": {"repository": {"const": "github.com/faustbrian/go-library-tools"}, "path": {"$ref": "#/$defs/safe_path"}, "source_revision": {"$ref": "#/$defs/git_sha"}, "bytes_sha256": {"$ref": "#/$defs/digest"}}},
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?:[a-z0-9]|[a-z0-9][a-z0-9./:_-]{0,126}[a-z0-9])$"},
    "safe_path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "not": {"anyOf": [{"const": "."}, {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}]}},
    "asset_name": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._-]+$", "not": {"enum": [".", ".."]}},
    "entry_point": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*#[A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)?\\(.*\\)(?: .+)?$", "$comment": "The suffix after # is an exported function or receiver-qualified exported method followed by its complete Go signature."},
    "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
    "entry_point_array": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/entry_point"}},
    "generator_release": {"type": "string", "maxLength": 128, "pattern": "^v(?:1\\.(?:5\\.(?:[6-9]|[1-9][0-9]+)|(?:[6-9]|[1-9][0-9]+)\\.[0-9]+)|(?:[2-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+)$"},
    "release_asset": {"type": "object", "additionalProperties": false, "$comment": "Semantic validation requires release_url to equal https://github.com/faustbrian/go-library-tools/releases/download/<release>/<asset> and requires release to equal the enclosing decision_freeze release.", "required": ["repository", "release", "release_url", "asset", "bytes_sha256"], "properties": {"repository": {"const": "github.com/faustbrian/go-library-tools"}, "release": {"$ref": "#/$defs/generator_release"}, "release_url": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://github\\.com/faustbrian/go-library-tools/releases/download/v[0-9]+\\.[0-9]+\\.[0-9]+/[A-Za-z0-9._-]+$"}, "asset": {"$ref": "#/$defs/asset_name"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 of every byte of this released support asset; no field is omitted."}}},
    "decision_freeze_asset": {"type": "object", "additionalProperties": false, "$comment": "Semantic validation requires release_url's version segment to equal release and requires every sibling provenance locator to use this same immutable generator release.", "required": ["repository", "release", "release_url", "asset", "schema_id", "bytes_sha256"], "properties": {"repository": {"const": "github.com/faustbrian/go-library-tools"}, "release": {"$ref": "#/$defs/generator_release"}, "release_url": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://github\\.com/faustbrian/go-library-tools/releases/download/v(?:1\\.(?:5\\.(?:[6-9]|[1-9][0-9]+)|(?:[6-9]|[1-9][0-9]+)\\.[0-9]+)|(?:[2-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+)/cohesion-schema-v3-decision-freeze\\.json$"}, "asset": {"const": "cohesion-schema-v3-decision-freeze.json"}, "schema_id": {"const": "urn:golib:cohesion:schema-v3-decision-freeze:v1"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 of every byte of the released decision-freeze asset; no field is omitted."}}},
    "schema_identity_and_assets": {
      "oneOf": [
        {"type": "object", "properties": {"schema_path": {"const": "schema/modules-v1.schema.json"}, "schema_id": {"const": "https://github.com/faustbrian/go-library-tools/schema/modules-v1.schema.json"}, "resolved_reference_graph": {"properties": {"asset": {"const": "modules-v1-resolved-reference-graph.json"}}, "required": ["asset"]}, "historical_baseline": {"properties": {"asset": {"const": "modules-v1-historical-baseline.json"}}, "required": ["asset"]}, "accepted_corpus": {"properties": {"asset": {"const": "modules-v1-accepted-corpus.json"}}, "required": ["asset"]}, "rejected_corpus": {"properties": {"asset": {"const": "modules-v1-rejected-corpus.json"}}, "required": ["asset"]}}, "required": ["schema_path", "schema_id", "resolved_reference_graph", "historical_baseline", "accepted_corpus", "rejected_corpus"]},
