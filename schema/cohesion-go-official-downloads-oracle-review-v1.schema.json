{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-go-official-downloads-oracle-review-v1.schema.json",
  "title": "Golib cohesion official Go-download oracle review schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "oracle", "extractor", "reviewer_id", "outcome", "findings", "created_at"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:go-official-downloads-oracle-review:v1"},
    "schema_version": {"const": 1},
    "oracle": {"$ref": "#/$defs/oracle_source"},
    "extractor": {"$ref": "#/$defs/extractor_source"},
    "reviewer_id": {"$ref": "#/$defs/identity"},
    "outcome": {"const": "accepted-no-findings"},
    "findings": {"type": "array", "maxItems": 0},
    "created_at": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "digest": {"description": "A lowercase SHA-256 digest of the exact bytes identified by the containing source; both reviewed sources are mandatory and never omitted.", "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9._/:-]*[a-z0-9])?$"},
    "path": {"description": "A repository-relative regular-file path; the schema rejects absolute paths, backslashes, empty and dot segments, while the released safe-path algorithm and UTF-8 byte bound remain mandatory semantic checks without narrowing Unicode names.", "type": "string", "minLength": 1, "maxLength": 4096, "not": {"anyOf": [{"pattern": "^/"}, {"pattern": "\\\\"}, {"pattern": "//"}, {"pattern": "(?:^|/)\\.{1,2}(?:/|$)"}]}},
    "timestamp": {"type": "string", "maxLength": 128, "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_revision", "bytes_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "source_revision": {"$ref": "#/$defs/commit"},
        "bytes_sha256": {"description": "SHA-256 of the exact reviewed source bytes at source_revision; the source is mandatory and this field is never omitted.", "$ref": "#/$defs/digest"}
      }
    },
    "oracle_source": {
      "allOf": [
        {"$ref": "#/$defs/source"},
        {"properties": {"path": {"const": "testdata/cohesion/go-official-downloads-oracle.json"}}, "required": ["path"]}
      ]
    },
    "extractor_source": {
      "allOf": [
        {"$ref": "#/$defs/source"},
        {"properties": {"path": {"const": "testdata/cohesion/go-official-downloads-extractor.go"}}, "required": ["path"]}
      ]
    }
  }
}
