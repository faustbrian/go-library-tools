{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/consumers.schema.json",
  "title": "Go library consumer inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "repositories"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "classification", "default_branch"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^go-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "classification": {
            "enum": ["active", "deferred", "tooling"]
          },
          "default_branch": {
            "type": "string",
            "pattern": "^(?![./])(?!.*(?:\\.\\.|@\\{|[\\\\ ~^:?*\\[\\t\\r\\n]))(?!.*[./]$).+$"
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "classification": {
                  "const": "active"
                }
              },
              "required": ["classification"]
            },
            "then": {
              "not": {
                "required": ["reason"]
              }
            }
          },
          {
            "if": {
              "properties": {
                "classification": {
                  "enum": ["deferred", "tooling"]
                }
              },
              "required": ["classification"]
            },
            "then": {
              "required": ["reason"]
            }
          }
        ]
      }
    }
  }
}
