{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/faustbrian/go-library-tools/main/schema/golib.schema.json",
  "title": "golib repository configuration",
  "description": "Repository-specific policy consumed by the golib CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Configuration schema version."
    },
    "tool_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Exact released golib CLI version."
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "$ref": "#/$defs/repositoryPath",
          "default": "modules.json"
        },
        "packages": {
          "$ref": "#/$defs/repositoryPath",
          "default": "packages.json"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "$ref": "#/$defs/repositoryPath",
          "default": ".verification"
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "$ref": "#/$defs/repositoryPath",
          "default": ".verification/mutation"
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deno": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "Exact Deno version required by repository tests."
        },
        "zsh": {
          "const": "5.9",
          "description": "Exact supported zsh runtime required by repository tests."
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module", "gate", "steps"],
        "properties": {
          "module": { "$ref": "#/$defs/repositoryPath" },
          "gate": {
            "enum": ["api", "benchmark", "conformance", "docs", "fuzz", "interoperability", "test"]
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/step" }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "gate": { "const": "test" } },
              "required": ["gate"]
            },
            "then": {
              "properties": {
                "steps": {
                  "items": {
                    "not": {
                      "anyOf": [
                        { "required": ["benchmark"] },
                        { "required": ["fuzz"] },
                        { "required": ["budget"] }
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "go-test" },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\.|\\./[^/]+(?:/[^/]+)*)$",
            "not": {
              "anyOf": [
                { "pattern": "\\\\" },
                { "pattern": "(?:^|/)\\.{1,2}(?:/|$)" },
                { "pattern": "(?:^|/)\\.\\.\\./.+" }
              ]
            }
          },
          "default": ["./..."]
        },
        "run": { "type": "string" },
        "benchmark": { "type": "string" },
        "fuzz": { "type": "string" },
        "budget": {
          "type": "string",
          "description": "Positive Go duration or iteration count ending in x; defaults to 100ms for benchmarks and 10000x for fuzzing."
        },
        "count": { "type": "integer", "minimum": 0, "default": 1 },
        "timeout": { "type": "string", "default": "20m" }
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          },
          {
            "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)"
          }
        ]
      }
    }
  }
}
