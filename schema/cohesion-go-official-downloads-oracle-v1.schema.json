{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-go-official-downloads-oracle-v1.schema.json",
  "title": "Golib cohesion official Go-download extraction oracle schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "official_index_sha256",
    "accepted_count",
    "accepted",
    "rejected_count",
    "rejected"
  ],
  "properties": {
    "schema_id": {
      "const": "urn:golib:cohesion:go-official-downloads-oracle:v1"
    },
    "schema_version": {
      "const": 1
    },
    "official_index_sha256": {
      "$ref": "#/$defs/digest",
      "description": "Exact-byte SHA-256 of the frozen official-index snapshot; no field is omitted."
    },
    "accepted_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "accepted": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/accepted"
      }
    },
    "rejected_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "rejected": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/rejected"
      }
    }
  },
  "$defs": {
    "digest": {
      "description": "A lowercase SHA-256 digest; each containing field description fixes the exact-byte or semantic-object domain and omission rule.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"
    },
    "go_version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^go(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\.(?:0|[1-9][0-9]*))?$"
    },
    "input_base64": {
      "type": "string",
      "maxLength": 44739244,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "goos",
        "goarch",
        "official_filename",
        "distribution_size",
        "distribution_sha256"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/go_version"
        },
        "goos": {
          "const": "linux"
        },
        "goarch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "official_filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "distribution_size": {
          "type": "integer",
          "minimum": 1
        },
        "distribution_sha256": {
          "$ref": "#/$defs/digest",
          "description": "Exact-byte SHA-256 formed by prepending sha256: to the selected official file checksum; no field is omitted."
        }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "input_base64",
        "expected"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identity"
        },
        "input_base64": {
          "$ref": "#/$defs/input_base64"
        },
        "expected": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/expected"
          }
        }
      }
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "input_base64",
        "error_code"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identity"
        },
        "input_base64": {
          "$ref": "#/$defs/input_base64"
        },
        "error_code": {
          "$ref": "#/$defs/identity"
        }
      }
    }
  }
}
