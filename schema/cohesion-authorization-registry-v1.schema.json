{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-authorization-registry-v1.schema.json",
  "title": "Golib cohesion authorization registry schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "goal_id", "requirements_sha256", "registry_revision", "predecessor_sha256", "entry_count", "entries"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:authorization-registry:v1"},
    "schema_version": {"const": 1},
    "goal_id": {"const": "golib-cohesion-v1"},
    "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."},
    "registry_revision": {"type": "integer", "minimum": 1},
    "predecessor_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}], "description": "Null at genesis; otherwise the exact-byte digest of the immediate predecessor registry file. This field is external to the predecessor bytes."},
    "bootstrap_freeze_sha256": {"$ref": "#/$defs/digest", "description": "Optional non-authorizing exact-byte digest of the externally frozen contract freeze; allowed only at genesis and external to the hashed freeze bytes."},
    "entry_count": {"type": "integer", "minimum": 0, "maximum": 4096, "description": "Must equal entries length."},
    "entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/entry"}}
  },
  "allOf": [
    {"if": {"properties": {"registry_revision": {"const": 1}}, "required": ["registry_revision"]}, "then": {"properties": {"predecessor_sha256": {"type": "null", "description": "Genesis has no predecessor exact-byte digest."}}}, "else": {"properties": {"predecessor_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the immediate predecessor registry file; this digest is external to those predecessor bytes."}}, "not": {"required": ["bootstrap_freeze_sha256"]}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9./:_-]*[a-z0-9])?$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "A repository-relative regular-file path. The exact released safeRelativePath algorithm and the 4096-byte UTF-8 bound are mandatory semantic checks; this shape intentionally does not narrow its accepted character set."},
    "delivery_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "goal_id", "requirements_sha256", "repository", "module", "dimension", "evidence_kind", "receipt_path", "receipt_sha256", "receipt_entry_id", "source_revision", "applicable_input_manifest_sha256", "outcome"],
      "properties": {"kind": {"const": "delivery"}, "goal_id": {"const": "golib-cohesion-v1"}, "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."}, "repository": {"$ref": "#/$defs/identity"}, "module": {"type": "string", "minLength": 1, "maxLength": 4096}, "dimension": {"enum": ["implementation", "hardening", "release"]}, "evidence_kind": {"enum": ["source-acceptance", "blocked-decision", "not-applicable-decision", "release-attestation"]}, "receipt_path": {"$ref": "#/$defs/path"}, "receipt_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the tracked receipt file; this field is external to the hashed receipt bytes."}, "receipt_entry_id": {"$ref": "#/$defs/identity"}, "source_revision": {"$ref": "#/$defs/commit"}, "applicable_input_manifest_sha256": {"$ref": "#/$defs/digest", "description": "Semantic-object digest equal to the receipt input_manifest_sha256; the digest field is absent from its own preimage."}, "outcome": {"const": "accepted"}}
    },
    "integration_role_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "goal_id", "requirements_sha256", "repository", "module", "target", "selected_role", "outcome"],
      "properties": {"kind": {"const": "integration-role"}, "goal_id": {"const": "golib-cohesion-v1"}, "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."}, "repository": {"$ref": "#/$defs/identity"}, "module": {"type": "string", "minLength": 1, "maxLength": 4096}, "target": {"$ref": "#/$defs/identity"}, "selected_role": {"enum": ["adapter", "companion", "domain-owned"]}, "outcome": {"const": "accepted"}}
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "path", "source_revision", "schema_id", "bytes_sha256"],
      "properties": {"repository": {"const": "github.com/faustbrian/go-library-tools"}, "path": {"$ref": "#/$defs/path"}, "source_revision": {"$ref": "#/$defs/commit"}, "schema_id": {"const": "urn:golib:cohesion:authorization-record:v1"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the canonical authorization-record file; this field is external to the hashed record bytes."}}
    },
    "entry_common": {
      "type": "object",
      "required": ["authorization_id", "authorization_kind", "subject", "record", "issuer_id"],
      "properties": {"authorization_id": {"$ref": "#/$defs/authorization_id"}, "authorization_kind": {"enum": ["decision-review", "release-authority", "integration-role-decision"]}, "subject": {"oneOf": [{"$ref": "#/$defs/delivery_subject"}, {"$ref": "#/$defs/integration_role_subject"}]}, "record": {"$ref": "#/$defs/record"}, "issuer_id": {"$ref": "#/$defs/authorization_id"}, "reviewer_id": {"$ref": "#/$defs/authorization_id"}, "release_verifier_id": {"$ref": "#/$defs/authorization_id"}, "supersedes_authorization_id": {"$ref": "#/$defs/authorization_id"}, "supersedes_record_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte digest of the superseded immediate-predecessor authorization record; this field is external to the hashed record bytes."}}
    },
    "supersession_pair": {"oneOf": [{"not": {"anyOf": [{"required": ["supersedes_authorization_id"]}, {"required": ["supersedes_record_sha256"]}]}}, {"required": ["supersedes_authorization_id", "supersedes_record_sha256"]}]},
    "decision_review_entry": {
      "allOf": [
        {"$ref": "#/$defs/entry_common"},
        {"$ref": "#/$defs/supersession_pair"},
        {
          "type": "object",
          "required": ["authorization_kind", "reviewer_id", "subject"],
          "not": {"required": ["release_verifier_id"]},
          "properties": {
            "authorization_kind": {"const": "decision-review"},
            "reviewer_id": {"$ref": "#/$defs/authorization_id"},
            "subject": {
              "allOf": [
                {"$ref": "#/$defs/delivery_subject"},
                {"oneOf": [
                  {"properties": {"dimension": {"const": "implementation"}, "evidence_kind": {"const": "source-acceptance"}}},
                  {"properties": {"evidence_kind": {"const": "blocked-decision"}}},
                  {"properties": {"evidence_kind": {"const": "not-applicable-decision"}}}
                ]}
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "release_authority_entry": {
      "allOf": [{"$ref": "#/$defs/entry_common"}, {"$ref": "#/$defs/supersession_pair"}, {"type": "object", "required": ["authorization_kind", "release_verifier_id", "subject"], "not": {"required": ["reviewer_id"]}, "properties": {"authorization_kind": {"const": "release-authority"}, "release_verifier_id": {"$ref": "#/$defs/authorization_id"}, "subject": {"allOf": [{"$ref": "#/$defs/delivery_subject"}, {"properties": {"dimension": {"const": "release"}, "evidence_kind": {"const": "release-attestation"}}}]}}}], "unevaluatedProperties": false
    },
    "integration_role_entry": {
      "allOf": [{"$ref": "#/$defs/entry_common"}, {"$ref": "#/$defs/supersession_pair"}, {"type": "object", "required": ["authorization_kind", "reviewer_id", "subject"], "not": {"required": ["release_verifier_id"]}, "properties": {"authorization_kind": {"const": "integration-role-decision"}, "reviewer_id": {"$ref": "#/$defs/authorization_id"}, "subject": {"$ref": "#/$defs/integration_role_subject"}}}], "unevaluatedProperties": false
    },
    "entry": {"oneOf": [{"$ref": "#/$defs/decision_review_entry"}, {"$ref": "#/$defs/release_authority_entry"}, {"$ref": "#/$defs/integration_role_entry"}]}
  }
}
