{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/cohesion-residual-register-v1.schema.json",
  "title": "Cohesion Residual Register V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "schema_version", "goal_id", "requirements_sha256", "inventory", "release_entry_count", "release_entries", "exception_entry_count", "exceptions", "resolution_count", "resolutions"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:residual-register:v1"}, "schema_version": {"const": 1},
    "goal_id": {"const": "golib-cohesion-v1"}, "requirements_sha256": {"const": "sha256:6e5ac948c2cf1ec439fdf90c53c0648befb74a65c3eca2eb595737ee8211891c", "description": "Exact-byte SHA-256 of the complete superseding goal-contract file; no field is omitted."},
    "inventory": {"$ref": "#/$defs/inventory_release_asset"},
    "release_entry_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "release_entries": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/release_entry"}},
    "exception_entry_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "exceptions": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/exception"}},
    "resolution_count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "resolutions": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/resolution"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^(?:[a-z0-9]|[a-z0-9][a-z0-9./:_-]{0,126}[a-z0-9])$"},
    "safe_path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "A canonical repository-relative path. The exact released safeRelativePath algorithm and 4096-byte UTF-8 bound are mandatory semantic checks; Unicode, spaces, @, +, ..foo, ...foo, and a/..foo remain representable, while absolute paths, backslashes, exact dot segments, traversal, and noncanonical cleaned paths are rejected semantically."},
    "repository_path": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/safe_path"}], "description": "A canonical repository directory; exact dot denotes the repository root, otherwise the released safeRelativePath algorithm is mandatory."},
    "file_path": {"allOf": [{"$ref": "#/$defs/safe_path"}, {"not": {"const": "."}}]},
    "asset_name": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9._-]+$", "not": {"enum": [".", ".."]}},
    "text": {"type": "string", "minLength": 1, "maxLength": 1048576, "pattern": "\\S"},
    "locator": {"type": "string", "minLength": 1, "maxLength": 4096},
    "classification": {"enum": ["justified-domain-specific", "intentional-compatibility", "temporary-pre-v1", "stale-documentation-or-metadata", "naming-or-package-layout-debt", "unsafe-or-ambiguous-public-behavior", "unresolved-maintainer-decision"]},
    "release_asset": {"type": "object", "additionalProperties": false, "required": ["repository", "release", "release_url", "asset", "bytes_sha256"], "properties": {"repository": {"$ref": "#/$defs/identity"}, "release": {"$ref": "#/$defs/identity"}, "release_url": {"$ref": "#/$defs/locator"}, "asset": {"$ref": "#/$defs/asset_name"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "SHA-256 of exact released asset bytes; no field is omitted."}}},
    "inventory_release_asset": {"type": "object", "additionalProperties": false, "$comment": "Semantic validation requires release_url's version segment to equal release and requires this locator to use the same immutable schema-v3 generator release as the enclosing locked input.", "required": ["repository", "release", "release_url", "asset", "bytes_sha256"], "properties": {"repository": {"const": "github.com/faustbrian/go-library-tools"}, "release": {"type": "string", "maxLength": 128, "pattern": "^v(?:1\\.(?:5\\.(?:[6-9]|[1-9][0-9]+)|(?:[6-9]|[1-9][0-9]+)\\.[0-9]+)|(?:[2-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+)$"}, "release_url": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^https://github\\.com/faustbrian/go-library-tools/releases/download/v(?:1\\.(?:5\\.(?:[6-9]|[1-9][0-9]+)|(?:[6-9]|[1-9][0-9]+)\\.[0-9]+)|(?:[2-9]|[1-9][0-9]+)\\.[0-9]+\\.[0-9]+)/cohesion-residual-inventory\\.json$"}, "asset": {"const": "cohesion-residual-inventory.json"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 of every byte of the released residual-inventory asset; no field is omitted."}}},
    "git_locator": {"type": "object", "additionalProperties": false, "required": ["repository", "path", "source_revision", "bytes_sha256"], "properties": {"repository": {"$ref": "#/$defs/identity"}, "path": {"$ref": "#/$defs/file_path"}, "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "bytes_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 of the file at the pinned Git revision; no field is omitted."}}},
    "evidence_reference": {"type": "object", "additionalProperties": false, "required": ["receipt_path", "receipt_sha256", "entry_id"], "properties": {"receipt_path": {"$ref": "#/$defs/file_path"}, "receipt_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 of the receipt file; no field is omitted."}, "entry_id": {"$ref": "#/$defs/identity"}}},
    "action_pair": {
      "properties": {"next_action": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}, "removal_condition": {"oneOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}},
      "oneOf": [
        {"properties": {"next_action": {"$ref": "#/$defs/text"}, "removal_condition": {"type": "null"}}},
        {"properties": {"next_action": {"type": "null"}, "removal_condition": {"$ref": "#/$defs/text"}}}
      ]
    },
    "release_nonterminal": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "repository", "module", "dimension", "state", "owner", "next_action", "removal_condition"],
      "properties": {"entry_id": {"$ref": "#/$defs/identity"}, "repository": {"$ref": "#/$defs/identity"}, "module": {"$ref": "#/$defs/identity"}, "dimension": {"const": "release"}, "state": {"enum": ["not-started", "in-progress"]}, "owner": {"$ref": "#/$defs/identity"}, "next_action": {}, "removal_condition": {}},
      "allOf": [{"$ref": "#/$defs/action_pair"}]
    },
    "release_blocked": {
      "type": "object", "additionalProperties": false,
      "required": ["entry_id", "repository", "module", "dimension", "state", "owner", "next_action", "removal_condition", "blocking_condition", "evidence_reference", "authorization_id"],
      "properties": {"entry_id": {"$ref": "#/$defs/identity"}, "repository": {"$ref": "#/$defs/identity"}, "module": {"$ref": "#/$defs/identity"}, "dimension": {"const": "release"}, "state": {"const": "blocked"}, "owner": {"$ref": "#/$defs/identity"}, "next_action": {}, "removal_condition": {}, "blocking_condition": {"$ref": "#/$defs/text"}, "evidence_reference": {"$ref": "#/$defs/evidence_reference"}, "authorization_id": {"$ref": "#/$defs/identity"}},
      "allOf": [{"$ref": "#/$defs/action_pair"}]
    },
    "release_entry": {"oneOf": [{"$ref": "#/$defs/release_nonterminal"}, {"$ref": "#/$defs/release_blocked"}]},
    "review_decision": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "outcome", "record"], "properties": {"reviewer_id": {"$ref": "#/$defs/identity"}, "outcome": {"enum": ["accepted", "rejected", "pending"]}, "record": {"$ref": "#/$defs/git_locator"}}},
    "temporary_exception": {"type": "object", "additionalProperties": false, "required": ["exception_id", "inventory_item_id", "repository", "module", "difference", "classification", "evidence", "owner", "review_decision", "disposition", "removal_condition"], "properties": {"exception_id": {"$ref": "#/$defs/identity"}, "inventory_item_id": {"$ref": "#/$defs/identity"}, "repository": {"$ref": "#/$defs/identity"}, "module": {"$ref": "#/$defs/identity"}, "difference": {"$ref": "#/$defs/text"}, "classification": {"$ref": "#/$defs/classification"}, "evidence": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/git_locator"}}, "owner": {"$ref": "#/$defs/identity"}, "review_decision": {"$ref": "#/$defs/review_decision"}, "disposition": {"const": "temporary"}, "removal_condition": {"$ref": "#/$defs/text"}}},
    "permanent_exception": {"type": "object", "additionalProperties": false, "required": ["exception_id", "inventory_item_id", "repository", "module", "difference", "classification", "evidence", "owner", "review_decision", "disposition", "permanence_reason"], "properties": {"exception_id": {"$ref": "#/$defs/identity"}, "inventory_item_id": {"$ref": "#/$defs/identity"}, "repository": {"$ref": "#/$defs/identity"}, "module": {"$ref": "#/$defs/identity"}, "difference": {"$ref": "#/$defs/text"}, "classification": {"$ref": "#/$defs/classification"}, "evidence": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/git_locator"}}, "owner": {"$ref": "#/$defs/identity"}, "review_decision": {"$ref": "#/$defs/review_decision"}, "disposition": {"const": "permanent"}, "permanence_reason": {"$ref": "#/$defs/text"}}},
    "exception": {"oneOf": [{"$ref": "#/$defs/temporary_exception"}, {"$ref": "#/$defs/permanent_exception"}]},
    "resolution_common": {"type": "object", "additionalProperties": false, "required": ["inventory_item_id", "state", "evidence"], "properties": {"inventory_item_id": {"$ref": "#/$defs/identity"}, "state": {"enum": ["resolved", "not-applicable"]}, "evidence": {"$ref": "#/$defs/git_locator"}}},
    "resolution_superseded": {"type": "object", "additionalProperties": false, "required": ["inventory_item_id", "state", "evidence", "successor_item_id"], "properties": {"inventory_item_id": {"$ref": "#/$defs/identity"}, "state": {"const": "superseded"}, "evidence": {"$ref": "#/$defs/git_locator"}, "successor_item_id": {"$ref": "#/$defs/identity"}}},
    "resolution": {"oneOf": [{"$ref": "#/$defs/resolution_common"}, {"$ref": "#/$defs/resolution_superseded"}]}
  }
}
