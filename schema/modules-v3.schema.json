{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/modules-v3.schema.json",
  "title": "Golib module inventory schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "repository", "go_version", "modules"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:module-manifest:v3"},
    "schema_version": {"const": 3},
    "repository": {"$ref": "#/$defs/identity"},
    "go_version": {"$ref": "modules-v2.schema.json#/$defs/go_version"},
    "modules": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "A v3 SHA-256 digest; its exact-byte or semantic-object domain is fixed by the field that uses it."},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "A repository-relative regular-file path. The exact released safeRelativePath algorithm and the 4096-byte UTF-8 bound are mandatory semantic checks; this shape intentionally does not narrow its accepted character set."},
    "module_directory": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/path"}], "description": "A nonempty canonical module directory; exact dot denotes the repository root, otherwise the released safeRelativePath algorithm is mandatory."},
    "dimension_state": {"enum": ["not-started", "in-progress", "blocked", "not-applicable", "verified"]},
    "goal_status": {"enum": ["not-started", "in-progress", "blocked", "complete", "not-applicable"]},
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "receipt_sha256", "entry_id"],
      "properties": {
        "receipt_path": {"$ref": "#/$defs/path"},
        "receipt_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 digest of the tracked regular receipt file; this field is external to the hashed file bytes."},
        "entry_id": {"$ref": "#/$defs/identity"}
      }
    },
    "evidence_array": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/evidence_reference"}},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirements_sha256", "status"],
      "properties": {
        "id": {"const": "golib-cohesion-v1"},
        "requirements_sha256": {"$ref": "#/$defs/digest", "description": "Exact-byte SHA-256 digest of the superseding frozen goal contract; this field is external to the hashed contract bytes."},
        "status": {"$ref": "#/$defs/goal_status"}
      }
    },
    "manifest_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "hardening", "release"],
      "properties": {
        "implementation": {"$ref": "#/$defs/evidence_array"},
        "hardening": {"$ref": "#/$defs/evidence_array"},
        "release": {"$ref": "#/$defs/evidence_array"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "implementation", "hardening", "release", "evidence"],
      "properties": {
        "goal": {"$ref": "#/$defs/goal"},
        "implementation": {"$ref": "#/$defs/dimension_state"},
        "hardening": {"$ref": "#/$defs/dimension_state"},
        "release": {"$ref": "#/$defs/dimension_state"},
        "evidence": {"$ref": "#/$defs/manifest_evidence"}
      },
      "allOf": [
        {"if": {"properties": {"implementation": {"enum": ["not-started", "in-progress"]}}, "required": ["implementation"]}, "then": {"properties": {"evidence": {"properties": {"implementation": {"maxItems": 0}}}}}, "else": {"properties": {"evidence": {"properties": {"implementation": {"minItems": 1}}}}}},
        {"if": {"properties": {"hardening": {"enum": ["not-started", "in-progress"]}}, "required": ["hardening"]}, "then": {"properties": {"evidence": {"properties": {"hardening": {"maxItems": 0}}}}}, "else": {"properties": {"evidence": {"properties": {"hardening": {"minItems": 1}}}}}},
        {"if": {"properties": {"release": {"enum": ["not-started", "in-progress"]}}, "required": ["release"]}, "then": {"properties": {"evidence": {"properties": {"release": {"maxItems": 0}}}}}, "else": {"properties": {"evidence": {"properties": {"release": {"minItems": 1}}}}}},
        {"oneOf": [
          {"properties": {"goal": {"properties": {"status": {"const": "complete"}}}, "implementation": {"const": "verified"}, "hardening": {"enum": ["verified", "not-applicable"]}}},
          {"properties": {"goal": {"properties": {"status": {"const": "complete"}}}, "implementation": {"const": "not-applicable"}, "hardening": {"const": "verified"}}},
          {"properties": {"goal": {"properties": {"status": {"const": "not-applicable"}}}, "implementation": {"const": "not-applicable"}, "hardening": {"const": "not-applicable"}}},
          {"properties": {"goal": {"properties": {"status": {"const": "blocked"}}}}, "anyOf": [{"properties": {"implementation": {"const": "blocked"}}}, {"properties": {"hardening": {"const": "blocked"}}}]},
          {"properties": {"goal": {"properties": {"status": {"const": "not-started"}}}, "implementation": {"enum": ["not-started", "not-applicable"]}, "hardening": {"enum": ["not-started", "not-applicable"]}}, "anyOf": [{"properties": {"implementation": {"const": "not-started"}}}, {"properties": {"hardening": {"const": "not-started"}}}]},
          {"properties": {"goal": {"properties": {"status": {"const": "in-progress"}}}, "implementation": {"enum": ["not-started", "in-progress", "not-applicable", "verified"]}, "hardening": {"enum": ["not-started", "in-progress", "not-applicable", "verified"]}}, "anyOf": [{"properties": {"implementation": {"const": "in-progress"}}}, {"properties": {"hardening": {"const": "in-progress"}}}, {"properties": {"implementation": {"const": "verified"}, "hardening": {"const": "not-started"}}}, {"properties": {"implementation": {"const": "not-started"}, "hardening": {"const": "verified"}}}]}
        ]}
      ]
    },
    "legacy_derived_role": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "role", "provenance", "rationale"],
      "properties": {"target": {"$ref": "#/$defs/identity"}, "role": {"enum": ["adapter", "companion"]}, "provenance": {"const": "legacy-derived"}, "rationale": {"$ref": "#/$defs/identity"}}
    },
    "authorized_role": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "role", "provenance", "rationale", "authorization_id"],
      "properties": {"target": {"$ref": "#/$defs/identity"}, "role": {"enum": ["adapter", "companion", "domain-owned"]}, "provenance": {"const": "authorized"}, "rationale": {"$ref": "#/$defs/identity"}, "authorization_id": {"$ref": "#/$defs/authorization_id"}}
    },
    "authorization_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9](?:[a-z0-9./:_-]*[a-z0-9])?$"},
    "integration_role": {"$ref": "#/$defs/authorized_role", "description": "Manifest-v3 authored role. legacy-derived is reserved for v1/v2 catalog preview projection and is not accepted here."},
    "cohesion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "secondary_capabilities", "responsibility", "non_goals", "public_package_identifier", "primary_entry_packages", "package_selection", "lifecycle_status", "maturity", "construction_styles", "lifecycle_styles", "ownership", "optional_owned_dependencies", "integration_roles", "supported_go", "supported_platforms", "supported_backends", "supported_protocols", "documentation", "known_good_compatibility_sets", "delivery"],
      "properties": {
        "family": {"enum": ["foundations", "service-edge", "protocols-and-descriptions", "persistence-and-durability", "resilience", "observability", "integration-and-data-movement", "domain-utilities", "tooling"]},
        "secondary_capabilities": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"enum": ["administration-and-control", "configuration", "cryptography-and-secrets", "data-encoding", "database-and-storage", "distributed-coordination", "eventing-and-messaging", "http-and-service-edge", "identity-and-access", "observability", "protocols-and-schemas", "resilience-and-admission", "scheduling-and-orchestration", "testing-and-conformance", "transport-and-networking"]}},
        "responsibility": {"$ref": "modules-v2.schema.json#/$defs/nonblank_string"},
        "non_goals": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "modules-v2.schema.json#/$defs/nonblank_string"}},
        "public_package_identifier": {"type": "string", "maxLength": 128, "pattern": "^(none|[A-Za-z_][A-Za-z0-9_]*)$"},
        "primary_entry_packages": {"$ref": "modules-v2.schema.json#/$defs/string_set"},
        "package_selection": {"type": "object", "maxProperties": 4096, "additionalProperties": {"$ref": "modules-v2.schema.json#/$defs/nonblank_string"}},
        "lifecycle_status": {"enum": ["active", "deprecated", "planned", "retired"]},
        "maturity": {"enum": ["experimental", "preview", "stable"]},
        "construction_styles": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"enum": ["builder-build", "builder-compile", "connect", "functional-options", "init", "load", "must-helper", "new-config", "new-options", "open", "plain-function", "validated-value"]}},
        "lifecycle_styles": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"enum": ["close", "drain", "run", "shutdown", "start", "stateless", "wait"]}},
        "ownership": {"$ref": "modules-v2.schema.json#/$defs/ownership"},
        "optional_owned_dependencies": {"$ref": "modules-v2.schema.json#/$defs/string_set"},
        "integration_roles": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/integration_role"}},
        "supported_go": {"$ref": "modules-v2.schema.json#/$defs/supported_go"},
        "supported_platforms": {"type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true, "items": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"}},
        "supported_backends": {"$ref": "modules-v2.schema.json#/$defs/identifier_set"},
        "supported_protocols": {"$ref": "modules-v2.schema.json#/$defs/identifier_set"},
        "documentation": {"$ref": "modules-v2.schema.json#/$defs/documentation"},
        "known_good_compatibility_sets": {"type": "array", "maxItems": 0},
        "delivery": {"$ref": "#/$defs/delivery"}
      },
      "allOf": [
        {"if": {"properties": {"lifecycle_status": {"const": "planned"}}, "required": ["lifecycle_status"]}, "then": {"properties": {"maturity": {"enum": ["experimental", "preview"]}, "documentation": {"properties": {"readme": {"type": "string", "minLength": 1}}}}}},
        {"if": {"properties": {"lifecycle_status": {"enum": ["active", "deprecated"]}}, "required": ["lifecycle_status"]}, "then": {"properties": {"documentation": {"properties": {"readme": {"type": "string", "minLength": 1}, "api": {"type": "string", "minLength": 1}, "changelog": {"type": "string", "minLength": 1}, "pkg_go_dev": {"type": "string", "minLength": 1}, "ecosystem_index": {"type": "string", "minLength": 1}}}}}}
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "module_path", "go_version", "kind", "purpose", "lifecycle", "releasable", "version", "tag_prefix", "gates", "test_tags", "build_tags", "required_services", "external_runtime_dependencies", "interoperability_tools", "conformance_corpora", "specifications", "owned_dependencies", "reverse_owned_dependencies", "packages", "family", "family_label", "family_description", "family_order", "goal_status", "goal_files", "goal_evidence", "provenance"],
      "properties": {
        "directory": {"$ref": "#/$defs/module_directory"}, "module_path": {"type": "string", "minLength": 1, "maxLength": 4096}, "go_version": {"$ref": "modules-v2.schema.json#/$defs/go_version"}, "kind": {"type": "string", "minLength": 1, "maxLength": 128}, "purpose": {"type": "string", "maxLength": 1048576}, "lifecycle": {"type": "string", "maxLength": 1048576}, "releasable": {"type": "boolean"}, "version": {"type": "string", "maxLength": 128}, "tag_prefix": {"type": "string", "maxLength": 128},
        "gates": {"$ref": "modules-v2.schema.json#/$defs/gates"}, "test_tags": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "build_tags": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "required_services": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "external_runtime_dependencies": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "interoperability_tools": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "conformance_corpora": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "specifications": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "owned_dependencies": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "reverse_owned_dependencies": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "packages": {"type": "array", "maxItems": 4096, "items": {"$ref": "modules-v2.schema.json#/$defs/package"}},
        "family": {"type": "string", "maxLength": 128}, "family_label": {"type": "string", "maxLength": 1048576}, "family_description": {"type": "string", "maxLength": 1048576}, "family_order": {"type": "integer", "minimum": 0}, "goal_status": {"type": "string", "maxLength": 128}, "goal_files": {"$ref": "modules-v2.schema.json#/$defs/string_set"}, "goal_evidence": {"type": "array", "maxItems": 4096, "items": {"$ref": "modules-v2.schema.json#/$defs/goal_evidence"}}, "provenance": {"type": "array", "maxItems": 4096, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}, "description": "Legacy-compatible sorted unique repository-relative provenance-file paths. Live inventory contains only this shape."}, "cohesion": {"$ref": "#/$defs/cohesion"}
      },
      "allOf": [{"if": {"properties": {"releasable": {"const": true}}, "required": ["releasable"]}, "then": {"required": ["cohesion"]}}]
    }
  }
}
