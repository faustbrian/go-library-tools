{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/faustbrian/go-library-tools/schema/modules-v3.schema.json",
  "title": "Golib module inventory schema v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "repository", "go_version", "modules"],
  "properties": {
    "schema_id": {"const": "urn:golib:cohesion:module-manifest:v3"},
    "schema_version": {"const": 3},
    "repository": {"type": "string", "minLength": 1},
    "go_version": {"$ref": "modules.schema.json#/$defs/go_version"},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "cohesion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "secondary_capabilities",
        "responsibility",
        "non_goals",
        "public_package_identifier",
        "primary_entry_packages",
        "package_selection",
        "lifecycle_status",
        "maturity",
        "construction_styles",
        "lifecycle_styles",
        "ownership",
        "optional_owned_dependencies",
        "adapters",
        "companions",
        "supported_go",
        "supported_platforms",
        "supported_backends",
        "supported_protocols",
        "documentation",
        "known_good_compatibility_sets"
      ],
      "properties": {
        "family": {"enum": ["foundations", "service-edge", "protocols-and-descriptions", "persistence-and-durability", "resilience", "observability", "integration-and-data-movement", "domain-utilities", "tooling"]},
        "secondary_capabilities": {"type": "array", "uniqueItems": true, "items": {"enum": ["administration-and-control", "configuration", "cryptography-and-secrets", "data-encoding", "database-and-storage", "distributed-coordination", "eventing-and-messaging", "http-and-service-edge", "identity-and-access", "observability", "protocols-and-schemas", "resilience-and-admission", "scheduling-and-orchestration", "testing-and-conformance", "transport-and-networking"]}},
        "responsibility": {"$ref": "modules.schema.json#/$defs/nonblank_string"},
        "non_goals": {"type": "array", "minItems": 1, "items": {"$ref": "modules.schema.json#/$defs/nonblank_string"}},
        "public_package_identifier": {"type": "string", "pattern": "^(none|[A-Za-z_][A-Za-z0-9_]*)$"},
        "primary_entry_packages": {"$ref": "modules.schema.json#/$defs/string_set"},
        "package_selection": {"type": "object", "additionalProperties": {"$ref": "modules.schema.json#/$defs/nonblank_string"}},
        "lifecycle_status": {"enum": ["active", "deprecated", "planned", "retired"]},
        "maturity": {"enum": ["experimental", "preview", "stable"]},
        "construction_styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["builder-build", "builder-compile", "connect", "functional-options", "init", "load", "must-helper", "new-config", "new-options", "open", "plain-function", "validated-value"]}},
        "lifecycle_styles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["close", "drain", "run", "shutdown", "start", "stateless", "wait"]}},
        "ownership": {"$ref": "modules.schema.json#/$defs/ownership"},
        "optional_owned_dependencies": {"$ref": "modules.schema.json#/$defs/string_set"},
        "adapters": {"$ref": "modules.schema.json#/$defs/string_set"},
        "companions": {"$ref": "modules.schema.json#/$defs/string_set"},
        "supported_go": {"$ref": "modules.schema.json#/$defs/supported_go"},
        "supported_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$"}},
        "supported_backends": {"$ref": "modules.schema.json#/$defs/identifier_set"},
        "supported_protocols": {"$ref": "modules.schema.json#/$defs/identifier_set"},
        "documentation": {"$ref": "modules.schema.json#/$defs/documentation"},
        "known_good_compatibility_sets": {"$ref": "modules.schema.json#/$defs/string_set"}
      },
      "allOf": [
        {"if": {"properties": {"lifecycle_status": {"const": "planned"}}, "required": ["lifecycle_status"]}, "then": {"properties": {"maturity": {"enum": ["experimental", "preview"]}, "documentation": {"properties": {"readme": {"type": "string", "minLength": 1}}}}}},
        {"if": {"properties": {"lifecycle_status": {"enum": ["active", "deprecated"]}}, "required": ["lifecycle_status"]}, "then": {"properties": {"documentation": {"properties": {"readme": {"type": "string", "minLength": 1}, "api": {"type": "string", "minLength": 1}, "changelog": {"type": "string", "minLength": 1}, "pkg_go_dev": {"type": "string", "minLength": 1}, "ecosystem_index": {"type": "string", "minLength": 1}}}}}}
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "module_path", "go_version", "kind", "purpose", "lifecycle", "releasable", "version", "tag_prefix", "gates", "test_tags", "build_tags", "required_services", "external_runtime_dependencies", "interoperability_tools", "conformance_corpora", "specifications", "owned_dependencies", "reverse_owned_dependencies", "packages", "family", "family_label", "family_description", "family_order"],
      "properties": {
        "directory": {"type": "string", "minLength": 1},
        "module_path": {"type": "string", "minLength": 1},
        "go_version": {"$ref": "modules.schema.json#/$defs/go_version"},
        "kind": {"type": "string", "minLength": 1},
        "purpose": {"type": "string"},
        "lifecycle": {"type": "string"},
        "releasable": {"type": "boolean"},
        "version": {"type": "string"},
        "tag_prefix": {"type": "string"},
        "gates": {"$ref": "modules.schema.json#/$defs/gates"},
        "test_tags": {"$ref": "modules.schema.json#/$defs/string_set"},
        "build_tags": {"$ref": "modules.schema.json#/$defs/string_set"},
        "required_services": {"$ref": "modules.schema.json#/$defs/string_set"},
        "external_runtime_dependencies": {"$ref": "modules.schema.json#/$defs/string_set"},
        "interoperability_tools": {"$ref": "modules.schema.json#/$defs/string_set"},
        "conformance_corpora": {"$ref": "modules.schema.json#/$defs/string_set"},
        "specifications": {"$ref": "modules.schema.json#/$defs/string_set"},
        "owned_dependencies": {"$ref": "modules.schema.json#/$defs/string_set"},
        "reverse_owned_dependencies": {"$ref": "modules.schema.json#/$defs/string_set"},
        "packages": {"type": "array", "items": {"$ref": "modules.schema.json#/$defs/package"}},
        "family": {"type": "string"},
        "family_label": {"type": "string"},
        "family_description": {"type": "string"},
        "family_order": {"type": "integer", "minimum": 0},
        "cohesion": {"$ref": "#/$defs/cohesion"}
      },
      "allOf": [{"if": {"properties": {"releasable": {"const": true}}, "required": ["releasable"]}, "then": {"required": ["cohesion"]}}]
    }
  }
}
